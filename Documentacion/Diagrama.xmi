      <UML:Class visibility="public" isSpecification="false" namespace="Logical_View" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uGrge2FDN0mnx" comment="comprueba si el jugador esta en la posicion ganadora y devuelve un bool" name="Arbitro">
       <UML:Classifier.feature>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="ufspAODP991Uf" comment="    Este metodo se encarga de verificar si un jugador ha ganado la partida, se utiliza en cada jugada del jugador&#xa;    @param pos: Recibe la posicion de la casilla en la que se encuentra el jugador &#xa;    @type pos: numero entero&#xa;    @returns: bool, devuelve true si el jugador en cuestion gano la partida&#xa;" isOverride="false" name="init" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="ulmnrvkMZVBwD" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uLro1sKnQSlx9" type="uWDbmXRdDrk6H" value="" name="cls"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uq7eHFVyAmbiO" comment="si las coordenadas de jugador son iguales a las de la casilla ganadora, gana = True    Este metodo comprueba la posicion del jugador en el tablero y si en esa casilla hay una serpiente o escalera, y aplica el movimiento&#xa;    indicado&#xa;    @param posTablero: recibe la posicion del jugador en el tablero&#xa;    @type posTablero: numero entero&#xa;    @return distancia: retorna la distancia que se tiene que recorrer, ya sea al final de la serpiente o el tope de la escalera&#xa;    @return coordenadasNuevas: retorna las coordenadas de la nueva casilla hacia donde se va a mover el jugador&#xa;    &#xa;" isOverride="false" name="comprobarGane" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="utLgOmcoXTIUF" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uQWDEeO8C5YJ6" type="uWDbmXRdDrk6H" value="" name="cls"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uhh0mMw22drUF" type="uWDbmXRdDrk6H" value="" name="pos"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uEJOBVkdpeALK" comment="comprueba si el jugador esta en una escalera o serpiente y lo mueve a donde le corresponde" isOverride="false" name="aplicarReglasMovimiento" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="ux5gTbnHFPkFv" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uLbMQ4JzXuwSw" type="uWDbmXRdDrk6H" value="" name="cls"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uMZqTZCeNa4gr" type="uWDbmXRdDrk6H" value="" name="posTablero"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uaiVcPKjahSoi" comment="    Este metodo se utiliza para decidir el orden de los turnos de los jugadores, cada uno lanza dados y el mas alto, va de primero y asi sucesivamente&#xa;    @param cantidad_jugadores: recibe la cantidad de jugadores que estan en la partida&#xa;    @type cantidad_jugadores: numero entero&#xa;    @param boton_dados: recibe una instancia de un boton de dados del cual se sacara la informacion de los dados&#xa;    @type boton_dados: instancia de la clase button&#xa;    @param dado: el dado que se lanzara para sacar un numero al azar&#xa;    @type dado: una instancia de dado&#xa;" isOverride="false" name="reporte_jugadores" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="u4E3vhi3OJdIT" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uCsqmH6JvNRQj" type="uWDbmXRdDrk6H" value="" name="cls"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="ud1x5Y7eqLCGy" type="uWDbmXRdDrk6H" value="" name="jugador"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uYmPgdLvYzEvv" comment="    Este metodo busca un jugador dentro del vector de turnos de acuerdo al valor que saco en los dados&#xa;    @param jugadores: el vector que guarda los turnos de los jugadores&#xa;    @type jugadores: un array de Jugador&#xa;    @param valor: la cantidad que tiro en los dados el jugador&#xa;    @type valor: numero entero&#xa;" isOverride="false" name="decidir_turnos" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uVFIGxEAjr4HZ" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uC45oEJndS1yG" type="uWDbmXRdDrk6H" value="" name="cls"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uSAn1ntK8tGwM" type="uWDbmXRdDrk6H" value="" name="cantidad_jugadores"/>
