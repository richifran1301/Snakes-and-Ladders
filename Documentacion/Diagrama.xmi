        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uzrAuOm30170y" comment="    Este metodo busca un jugador dentro del vector de turnos de acuerdo al valor que saco en los dados&#xa;    @param jugadores: el vector que guarda los turnos de los jugadores&#xa;    @type jugadores: un array de Jugador&#xa;    @param valor: la cantidad que tiro en los dados el jugador&#xa;    @type valor: numero entero&#xa;" isOverride="false" name="decidir_turnos" isInline="false" isVirtual="false">
