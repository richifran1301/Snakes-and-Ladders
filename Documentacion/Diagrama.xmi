        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uVhyco4MCDUYZ" comment="        Metodo que va a devolver el nombre del Jugador.&#xa;        :returns: nombre del jugador, es tipo string.&#xa;" isOverride="false" name="getNombre" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uxteD8BTiCUm3" type="uWDbmXRdDrk6H"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="u0KX6tCxwTWpp" comment="        Metodo que se encarga de realizar el movimiento del jugador y requiere de la participacion del&#xa;        Arbitro para saber si: gano; si cayo en una escalera o serpiente y necesita moverse (tampoco sabe&#xa;        adonde habria que moverse, el Arbitro le indica);y por ultimo, si ya no tiene que moverse mas.&#xa;        :param distancia: cantidad de casillas a moverse, puede ser el numero que salio en los dados, o&#xa;        puede ser lo que debe moverse por haber caido en escalera o serpiente.&#xa;        :type distancia: int&#xa;        :param coordenadas: coordenadas en X y Y de la casilla (especificamente en el centro de ella) adonde &#xa;        el Jugador tiene que moverse.&#xa;        :type coordenadas: tupla de int&#xa; + movX para evitar complicaciones visuales con numeros en centro de casilla     + movY para evitar posibles choques con escaleras o serpientes visualmente en casillaprimero comprueba si el jugador en la nueva posicion ganosi no gano, comprueba si esta en una serp o escalerasi esta en una serpiete o escalera, va a tener que moverse a la posicion indicadaretorna el bool si gano, para cerrar el juego" isOverride="false" name="mover" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="upbDSVYsXs39q" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uvZ4rTmEqXJwz" type="uWDbmXRdDrk6H" value="" name="distancia"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uwwHzSYDeq5HU" type="uWDbmXRdDrk6H" value="" name="coordenadas"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uiXlSZuvJkfEv" comment="        Metodo que ilustra al jugador en la vetana de pygame. Lo dibuja para que el usuario&#xa;        pueda observarlo.&#xa;" isOverride="false" name="dibujar" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uslT53HCDzPq2" type="uWDbmXRdDrk6H"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
       </UML:Classifier.feature>
      </UML:Class>
