    <sourcecode value="self.tamanio=tamanio&#xa;self.ventana=ventana&#xa;self.casillas=[]&#xa;self.serpientes=[]&#xa;self.escaleras=[]&#xa;self.generarCasillas()&#xa;self.colorearCasillas()&#xa;self.dibujarCasillas()&#xa;self.ancho_barra=ancho_barra&#xa;" id="ueWUJbmPymcuX"/>
    <sourcecode value="if Singleton.es_partida_cargada:&#xa;  self.serpientes=[]&#xa;  self.escaleras=[]&#xa;  self.casillas=[]&#xa;  Singleton.escaleras=[]&#xa;  Singleton.serpientes=[]&#xa;  Singleton.casillasTablero=[]&#xa;&#xa;alto,ancho=700,700&#xa;if not Singleton.es_partida_cargada:&#xa;cantidad_serpientes=int((self.tamanio[0]*self.tamanio[1])*((random.randint(5,7))*0.01))cantidad_escaleras=int((self.tamanio[0]*self.tamanio[1])*((random.randint(5,7))*0.01))else:&#xa;  cantidad_escaleras=Singleton.cantidad_escaleras&#xa;  cantidad_serpientes=Singleton.cantidad_serpientes&#xa;&#xa;centros_casillas=self.obtener_centro_casillas(alto,ancho)&#xa;if not Singleton.es_partida_cargada:&#xa;  posiciones_serpientes,posiciones_escaleras=self.generar_conexiones(centros_casillas,cantidad_serpientes,cantidad_escaleras)&#xa;&#xa;else:&#xa;  posiciones_escaleras=[]&#xa;  posiciones_serpientes=[]&#xa;  posiciones_escaleras=Singleton.indices_escaleras&#xa;  posiciones_serpientes=Singleton.indices_serpientes&#xa;&#xa;for i in range(len(centros_casillas)):&#xa;  encontrado=False&#xa;  for j in range(len(posiciones_serpientes)):&#xa;    if not encontrado and i in posiciones_serpientes[j]:&#xa;      figura=pygame.Rect(centros_casillas[i][0]-int((alto//self.tamanio[0])//2),centros_casillas[i][1]-int((ancho//self.tamanio[1])/2),alto//self.tamanio[0],ancho//self.tamanio[1])&#xa;      serpiente=CasillaSerpiente(centros_casillas[i],(255,255,255),figura,i,self.ventana)&#xa;      self.casillas.append(serpiente)&#xa;      encontrado=True&#xa;&#xa;    if encontrado:&#xa;      break&#xa;&#xa;&#xa;  for k in range(len(posiciones_escaleras)):&#xa;    if not encontrado and i in posiciones_escaleras[k]:&#xa;      figura=pygame.Rect(centros_casillas[i][0]-int((alto//self.tamanio[0])//2),centros_casillas[i][1]-int((ancho//self.tamanio[1])/2),alto//self.tamanio[0],ancho//self.tamanio[1])&#xa;      escalera=CasillaEscalera(centros_casillas[i],(255,255,255),figura,i,self.ventana)&#xa;      self.casillas.append(escalera)&#xa;      encontrado=True&#xa;&#xa;    if encontrado:&#xa;      break&#xa;&#xa;&#xa;  if not encontrado:&#xa;    figura=pygame.Rect(centros_casillas[i][0]-int((alto//self.tamanio[0])//2),centros_casillas[i][1]-int((ancho//self.tamanio[1])//2),alto//self.tamanio[0],ancho//self.tamanio[1])&#xa;    casillaEstandar=CasillaEstandar(centros_casillas[i],(255,255,255),figura,i,self.ventana)&#xa;    self.casillas.append(casillaEstandar)&#xa;&#xa;&#xa;for i in range(len(self.casillas)):&#xa;  if isinstance(self.casillas[i],CasillaSerpiente):&#xa;    if not self.existeConexion(self.casillas[i].getIndice()):&#xa;      self.serpientes.append(Serpiente(self.getPar(self.casillas[i].getIndice(),posiciones_serpientes),self.ventana))&#xa;      self.serpientes[len(self.serpientes)-1].sendConector()&#xa;&#xa;&#xa;  elif isinstance(self.casillas[i],CasillaEscalera):&#xa;    if not self.existeConexion(self.casillas[i].getIndice()):&#xa;      self.escaleras.append(Escalera(self.getPar(self.casillas[i].getIndice(),posiciones_escaleras),self.ventana))&#xa;      self.escaleras[len(self.escaleras)-1].sendConector()&#xa;&#xa;&#xa;&#xa;for serpiente in self.serpientes:Singleton.serpientes.append(serpiente)&#xa;for escalera in self.escaleras:Singleton.escaleras.append(escalera)&#xa;for casilla in self.casillas:Singleton.casillasTablero.append(casilla)&#xa;for serpiente in Singleton.serpientes:&#xa;  print(&quot;SERPIENTE INICIO: &quot;+str(serpiente.getCasillaInicio().getIndice()))&#xa;&#xa;" id="u5wVo178TXv5N"/>
    <sourcecode value="for i in posiciones:&#xa;  if indice in i:&#xa;    return i&#xa;&#xa;&#xa;return&#xa;" id="uvcuEC6KkILa7"/>
    <sourcecode value="temp_par=self.getPosicionesEnTupla(indice,posiciones)&#xa;tupla=(self.casillas[temp_par[0]],self.casillas[temp_par[1]])&#xa;return tupla&#xa;" id="uog0hcB7kvJSG"/>
    <sourcecode value="for i in range(len(self.serpientes)):&#xa;  if indice==self.serpientes[i].getCasillaInicio().getIndice()or indice==self.serpientes[i].getCasillaFinal().getIndice():&#xa;    return True&#xa;&#xa;&#xa;for i in range(len(self.escaleras)):&#xa;  if indice==self.escaleras[i].getCasillaInicio().getIndice()or indice==self.escaleras[i].getCasillaFinal().getIndice():&#xa;    return True&#xa;&#xa;&#xa;return False&#xa;" id="u0iI2tnzoOXaj"/>
    <sourcecode value="serpientes_temp=[]&#xa;generados=0&#xa;while generados&lt;cantidad*2:&#xa;  while True:&#xa;    valor=random.randint(1,len(casillas)-2)&#xa;    if(valor not in escaleras)and(valor not in serpientes_temp):&#xa;      serpientes_temp.append(valor)&#xa;      break&#xa;&#xa;&#xa;  generados+=1&#xa;&#xa;return serpientes_temp&#xa;" id="uuwK4TK7Protj"/>
    <sourcecode value="escaleras_temp=[]&#xa;generados=0&#xa;while generados&lt;cantidad*2:&#xa;  while True:&#xa;    valor=random.randint(1,len(casillas)-2)&#xa;    if valor not in escaleras_temp:&#xa;      escaleras_temp.append(valor)&#xa;      break&#xa;&#xa;&#xa;  generados+=1&#xa;&#xa;return escaleras_temp&#xa;" id="u10hZi87PhxDI"/>
    <sourcecode value="escaleras_temp=self.generar_escaleras(casillas,cantidad_escaleras)&#xa;serpientes_temp=self.generar_serpientes(escaleras_temp,casillas,cantidad_serpientes)&#xa;escaleras=[]&#xa;serpientes=[]&#xa;for i in range(0,len(escaleras_temp),2):&#xa;  valorInicial=0&#xa;  valorFinal=0&#xa;  if escaleras_temp[i]&lt;escaleras_temp[i+1]:&#xa;  valorInicial=escaleras_temp[i]valorFinal=escaleras_temp[i+1]else:&#xa;    valorInicial=escaleras_temp[i+1]&#xa;    valorFinal=escaleras_temp[i]&#xa;&#xa;  tupla=(valorInicial,valorFinal)&#xa;  escaleras.append(tupla)&#xa;&#xa;for i in range(0,len(serpientes_temp),2):&#xa;  valorInicial=0&#xa;  valorFinal=0&#xa;  if serpientes_temp[i]>serpientes_temp[i+1]:&#xa;    valorInicial=serpientes_temp[i]&#xa;    valorFinal=serpientes_temp[i+1]&#xa;&#xa;  else:&#xa;    valorInicial=serpientes_temp[i+1]&#xa;    valorFinal=serpientes_temp[i]&#xa;&#xa;  tupla=(valorInicial,valorFinal)&#xa;  serpientes.append(tupla)&#xa;&#xa;return serpientes,escaleras&#xa;" id="u3Kuu0v10ONvH"/>
    <sourcecode value="casillas_temp=[]&#xa;temp=centro_casillas_x&#xa;for i in range(0,len(centro_casillas_y)):&#xa;  if(i%2==0):&#xa;    for j in range(len(centro_casillas_x)):&#xa;      tupla_temp=(centro_casillas_x[j],centro_casillas_y[i])&#xa;      casillas_temp.append(tupla_temp)&#xa;&#xa;&#xa;  else:&#xa;    for k in range(len(temp)):&#xa;      tupla_temp=(temp[k],centro_casillas_y[i])&#xa;      casillas_temp.append(tupla_temp)&#xa;&#xa;&#xa;  temp.reverse()&#xa;&#xa;return casillas_temp&#xa;" id="uxXrud3mtxA9I"/>
    <sourcecode value="centro_casillas=[]&#xa;for i in range(max_iteracion):&#xa;  centro_casillas.append(int(x/2)+(i*x))&#xa;&#xa;return centro_casillas&#xa;" id="uc4b2wO762Prn"/>
    <sourcecode value="centro_casillas=[]&#xa;centro_casillas_x=[]&#xa;centro_casillas_y=[]&#xa;cantidad_casillas_x,cantidad_casillas_y=self.tamanio[0],self.tamanio[1]&#xa;ancho_casilla=int(ancho_total/cantidad_casillas_x)&#xa;altura_casilla=int(alto_total/cantidad_casillas_y)&#xa;centro_casillas_x=self.obtener_casillas(ancho_casilla,cantidad_casillas_x)&#xa;centro_casillas_y=self.obtener_casillas(altura_casilla,cantidad_casillas_y)&#xa;centro_casillas_y.reverse()&#xa;centro_casillas=self.obtener_orden_coordenadas(centro_casillas_x,centro_casillas_y)&#xa;return centro_casillas&#xa;" id="ui0uORCM0y0Yk"/>
    <sourcecode value="colores_x=[&quot;amarillo&quot;,&quot;blanco&quot;,&quot;rojo&quot;,&quot;azul&quot;,&quot;verde&quot;]&#xa;i=0&#xa;indice_color_x=0&#xa;indice_color_y=0&#xa;par_actual,par_final=0,self.tamanio[0]&#xa;impar_actual,impar_final=self.tamanio[0]*2-1,self.tamanio[0]-1&#xa;while i&lt;self.tamanio[1]//2:&#xa;for j in range(par_actual,par_final):&#xa;  if isinstance(self.casillas[j],CasillaEstandar):&#xa;    self.casillas[j].setColor(colores_x[indice_color_x])&#xa;&#xa;  else:&#xa;    self.casillas[j].setColor(colores_x[indice_color_x])&#xa;&#xa;  indice_color_x+=1&#xa;  if indice_color_x>4:&#xa;    indice_color_x=0&#xa;&#xa;&#xa;for j in range(impar_actual,impar_final,-1):&#xa;  if isinstance(self.casillas[j],CasillaEstandar):&#xa;    self.casillas[j].setColor(colores_x[(indice_color_x+3)%5])&#xa;&#xa;  else:&#xa;    self.casillas[j].setColor(colores_x[(indice_color_x+3)%5])&#xa;&#xa;  indice_color_x+=1&#xa;  if indice_color_x>4:&#xa;    indice_color_x=0&#xa;&#xa;&#xa;indice_color_y+=1&#xa;if indice_color_y>4:&#xa;  indice_color_y=0&#xa;&#xa;indice_color_x=indice_color_y&#xa;par_actual+=self.tamanio[0]*2 par_final+=self.tamanio[0]*2 impar_actual+=self.tamanio[0]*2 impar_final+=self.tamanio[0]*2 i+=1" id="u6rNFQqIZmRx6"/>
    <sourcecode value="for c in self.casillas:&#xa;  c.dibujar()&#xa;&#xa;for i in self.serpientes:&#xa;  i.dibujar()&#xa;&#xa;for i in self.escaleras:&#xa;  i.dibujar()&#xa;&#xa;" id="u0nkMuDy1mtXJ"/>
    <sourcecode value="if isinstance(self.casillas[index],CasillaEstandar):&#xa;  self.casillas[index].dibujar()&#xa;&#xa;else:&#xa;  self.casillas[index].casilla.dibujar()&#xa;  conector=self.casillas[index].casilla.getConector()&#xa;  if isinstance(conector,Serpiente):&#xa;    self.serpientes.index(conector).dibujar()&#xa;&#xa;  elif isinstance(conector,Escalera):&#xa;    self.escaleras.index(conector).dibujar()" id="ugxHhfyp9zn6g"/>
