      <UML:Class visibility="public" isSpecification="false" namespace="Logical_View" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uSM9VynIGC1OK" comment="    Clase que representa al espacio extra en la ventana de pygame, que no pertenece al tablero.&#xa;    Contiene informacion valiosa que le comuncia al jugador el turno, quien gana, como moverse...&#xa;    Ademas, en este espacio se juega con los dados para decidir turnos y permitir al jugador moverse&#xa;    en el juego. &#xa;" name="Sidebar">
       <UML:Classifier.feature>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="ucfrp43t2LkxL" type="u8ncWzU6uaHhv" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" name="alto_total"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="uLB70pLP5PSC5" type="u8ncWzU6uaHhv" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" name="ancho_total"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="uONrRUgAxOxQL" type="u8ncWzU6uaHhv" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" name="ancho_sidebar"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="u8948W1GonZIL" type="u8ncWzU6uaHhv" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" name="mi_color"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="uuU8qTzH0XWFW" type="u0xl5OuSC8PmI" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" initialValue="(700,0,ancho_sidebar,alto_total)" name="mi_forma"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="uRoSLWkp8SO3c" type="u8ncWzU6uaHhv" comment=":param alto_total = medida del alto de la ventana de pygame &#xa;:type alto_total: int&#xa;:param ancho_total = medida del ancho de la ventana de pygame&#xa;:type ancho_total: int&#xa;:param alto_sidebar = medida del alto de este espacio al lado del tablero &#xa;:type alto_sidebar: int&#xa;:param ancho_sidebar = medida del ancho de este espacio al lado del tablero &#xa;:type ancho_sidebar: int&#xa;:param mi_color: codigo del color a escoger&#xa;:type color: codigo de color perteneciente a la lista de colores de Singleton.&#xa;:param elementos: lista que contiene al boton de los dados, y los dados.&#xa;:type elementos: lista&#xa;" name="elementos"/>
