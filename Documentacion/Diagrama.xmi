      <UML:Class visibility="public" isSpecification="false" namespace="Logical_View" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="ucaBXS1BsDLp3" comment="comprueba si el jugador esta en la posicion ganadora y devuelve un bool" name="Arbitro">
       <UML:Classifier.feature>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="upgmUmc3oQAcU" comment="    Este metodo se encarga de verificar si un jugador ha ganado la partida, se utiliza en cada jugada del jugador&#xa;    @param pos: Recibe la posicion de la casilla en la que se encuentra el jugador &#xa;    @type pos: numero entero&#xa;    @returns: bool, devuelve true si el jugador en cuestion gano la partida&#xa;" isOverride="false" name="init" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="u7IgqZ1yAxZH8" type="ubpT3V8kZN49o"/>
