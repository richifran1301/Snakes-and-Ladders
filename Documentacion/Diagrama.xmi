        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uU5wFV5w3NPvz" comment="        Esta funciÃ³n colorea las casillas con un algoritmo que impide colores consecutivos. &#xa;        :returns:  None -- Procedimiento sin valor de retorno.&#xa; favor documentar este algoritmoColoreado filas paresColoreado filas impares" isOverride="false" name="colorearCasillas" isInline="false" isVirtual="false">
