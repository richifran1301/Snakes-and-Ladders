      <UML:Class visibility="public" isSpecification="false" namespace="Logical_View" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="utBhPqzU8N9N3" comment="    Esta clase representa un dado de seis caras, y sus atributos y acciones necesarios &#xa;    para su comportamiento en un tablero de juego.&#xa;" name="Dado">
       <UML:Classifier.feature>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="unNcy4PeoHGca" type="uRNQ8mzUMKBA0" comment=":param ventana: Referencia a la ventana de pygame.&#xa;:type ventana: pygame.display&#xa;valores de las caras" initialValue="[1,2,3,4,5,6]" name="valores_caras"/>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="ubgB4JfxrxjSb" type="u8ncWzU6uaHhv" comment=":param ventana: Referencia a la ventana de pygame.&#xa;:type ventana: pygame.display&#xa;valores de las caras" initialValue="None" name="caras"/>
        <UML:Operation stereotype="constructor" visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="ug4p1pJgr39ai" comment="        :param ventana: Referencia a la ventana de pygame.&#xa;        :type ventana: pygame.display&#xa; valores de las caras" isOverride="false" name="__init__" isInline="false" isVirtual="false">
