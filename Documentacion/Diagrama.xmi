        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="uaQaZnwXyjYQe" comment="        :param an: ancho del tablero&#xa;        :type an: int &#xa;        :param al: largo del tablero.&#xa;        :type al: int&#xa;        :param cantX: cantidad de casillas horizontalmente (en coordenadas X)&#xa;        :type cantX: int&#xa;        :param cantX: cantidad de casillas verticalmente (en coordenadas Y)&#xa;        :type cantY: int&#xa;        :param casillaGanadora: posicion de casilla ganadora&#xa;        :type casillaGanadora: int&#xa;        :param casillasT: casillas del tablero &#xa;        :type: vector de objetos Casilla &#xa;        :param vent: Referencia a la ventana de pygame.&#xa;        :type vent: pygame.display&#xa;copia las casillas del tablero guarda las coordenadas de la casilla 100 en tablero 10x10 por ejemplo (ganadora)" isOverride="false" name="init" isInline="false" isVirtual="false">
