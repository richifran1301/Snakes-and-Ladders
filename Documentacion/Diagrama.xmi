        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uSpvlQNPip9WY" comment="        Metodo que va a devolver el nombre del Jugador.&#xa;        :returns: nombre del jugador, es tipo string.&#xa;" isOverride="false" name="getNombre" isInline="false" isVirtual="false">
