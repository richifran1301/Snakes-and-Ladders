        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="u8tYesbiSadyc" comment="        Metodo que se encarga de darle nombre al Jugador y almacenarlo en la variable nombre.&#xa;        :param nombre: nombre para ponerle al Jugador&#xa;        :type nombre: string&#xa;" isOverride="false" name="setNombre" isInline="false" isVirtual="false">
