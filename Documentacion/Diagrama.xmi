        <UML:Operation stereotype="constructor" visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="ueWUJbmPymcuX" comment="        :param tamanio: TamaÃ±o del tablero en pÃ­xeles como tupla (ancho, alto).&#xa;        :type tamanio: tuple&#xa;        :param ventana: Referencia a la ventana de pygame.&#xa;        :type ventana: pygame.display&#xa;        :param ancho_barra: Ancho de la sidebar junto al tablero.&#xa;        :type ancho_barra: int&#xa; lista de casillas del tablero lista de conectores tipo serpiente del tablero lista de conectores tipo escalera del tablero se llama a la funciÃ³n que genera casillas" isOverride="false" name="__init__" isInline="false" isVirtual="false">
