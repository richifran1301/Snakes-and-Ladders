    <sourcecode value="centros_casillas=self.obtener_centro_casillas(Singleton.alto_tablero,Singleton.ancho_tablero)&#xa;for i in range(len(centros_casillas)):&#xa;  figura=pygame.Rect(centros_casillas[i][0]-int((Singleton.alto_tablero//self.tamanio[0])//2),&#xa;  centros_casillas[i][1]-int((Singleton.ancho_tablero//self.tamanio[1])//2),Singleton.alto_tablero//self.tamanio[0],Singleton.ancho_tablero//self.tamanio[1])casillaEstandar=CasillaEstandar(centros_casillas[i],(255,255,255),figura,i,self.ventana)&#xa;  self.casillas.append(casillaEstandar)&#xa;&#xa;" id="uoCaqRtJlW3df"/>
