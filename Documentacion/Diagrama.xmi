        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uB4uGWvob2JZ1" comment="        Metodo que limpia la casilla actual donde se ubica el jugador. &#xa;        :param index: posicion en el tablero donde esta el usuario&#xa;        :type index: int&#xa;Primero limpia la posicion actualdibuja si hay serpiente lo intente simplemente conector.dibujar() pero tampococonector.dibujar()dibuja si hay escalera" isOverride="false" name="limpar_casilla" isInline="false" isVirtual="false">
