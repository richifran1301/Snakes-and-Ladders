        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uB5wCof2cuAJC" comment="        Esta funciÃ³n genera una lista con las coordenadas de cada casilla en el orden lÃ³gico de recorrido del tablero. &#xa;        :param centro_casillas_x: Lista de centros de casillas en eje x.&#xa;        :type centro_casillas_x: list&#xa;        :param centro_casillas_y: Lista de centros de casillas en eje y.&#xa;        :type centro_casillas_y: list&#xa;        :returns:  list -- Devuelve la lista con coordenadas de todas las casillas (x, y) como tuplas.&#xa; favor documentar el funcionamiento de este algoritmo" isOverride="false" name="obtener_orden_coordenadas" isInline="false" isVirtual="false">
