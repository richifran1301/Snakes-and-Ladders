        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uztSAbSUxcHPh" comment="        Va a almacenar un color para el Jugador y esto es decision del usuario. El color tiene que existir dentro de las opciones&#xa;        y no puede repetirse. El color es unico por jugador en la partida.&#xa;" isOverride="false" name="setColor" isInline="false" isVirtual="false">
