        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="u3Up4iB33q4A2" comment="        Esta funciÃ³n dibuja las casillas y sus conectores en la ventana.&#xa;        :returns:  None -- Procedimiento sin valor de retorno.&#xa; para cada casilla dibuje las decoradas y las estÃ¡ndar para cada serpiente dibÃºjese para cada escalera dibÃºjeseTODO mejorar condicion de limpieza" isOverride="false" name="dibujarCasillas" isInline="false" isVirtual="false">
