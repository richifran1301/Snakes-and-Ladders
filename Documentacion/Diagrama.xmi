        <UML:Operation stereotype="constructor" visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="ubKNNe1LEFimj" comment="Esta clase corresponde a la del Jugador que participa en el juego. Realiza las &#xa;interacciones dadas por el usuario y depende totalmente de el. Van a haber entre 2 &#xa;a 4 jugadores por juego.&#xa;" isOverride="false" name="__init__" isInline="false" isVirtual="false">
