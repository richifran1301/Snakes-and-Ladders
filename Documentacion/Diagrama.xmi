         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uAnAVUOjzws81" comment="        Esta funciÃ³n dibuja los dados resultantes de un lanzamiento y arroja la suma de sus valores.&#xa;        :returns:  int -- Suma de las caras resultantes de ambos dados.&#xa; genere dos nÃºmeros aleatorios entre 1 y 6, ambos inclusive sume los resultados dibuje los resultados" isOverride="false" name="lanzar" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uEOM5P4BtSWEB" type="uWDbmXRdDrk6H"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="u3e3f9kEIN7dI" comment="        Esta funciÃ³n dibuja dos dados segÃºn el resultado de sus caras.&#xa;        :returns:  None -- Procedimiento sin valor de retorno.&#xa; direcciÃ³n de las imÃ¡genes de los dados haga el proceso de dibujo de la primera cara del dado, de pygame para imÃ¡genes or .convert_alpha() lo mismo para la segunda cara or .convert_alpha()" isOverride="false" name="dibujar" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uPjsVJCu9ZeiK" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uGtCofYWroOBT" type="uWDbmXRdDrk6H" value="" name="resultados_por_dado"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="urVgOojGOot1N" comment="        Este metodo va a esperar que el usuario presione en la interfaz, el boton de tirar dados. Va a representar&#xa;        los dados graficamente tambien, y almacenar el valor guardado en una variable llamada resultado_dados.&#xa;        Ademas, cambia el color de la opcion del boton si se tiene el cursor sobre el. Por ultimo, tambien contempla &#xa;        la opcion de que el usuario presione la equis para salir del juego y es una opcion normal para salirse.&#xa;        :param boton_dados: representacion del boton de los dados, cuando el usuario hace clic sobre el es que se &#xa;        tiran los dados.&#xa;        :type boton_dados: Button&#xa;        :returns: variable que almaceno el valor sumado que salio en los dados&#xa; esta variable contiene ahora el numero que lanzaron los dados. usar donde se necesite." isOverride="false" name="espere_repuesta_dados" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="umQ5uBRmHqSFn" type="uWDbmXRdDrk6H"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="uI4NnxdabTBdF" type="uWDbmXRdDrk6H" value="" name="boton_dados"/>
         </UML:BehavioralFeature.parameter>
        </UML:Operation>
       </UML:Classifier.feature>
      </UML:Class>
      <UML:Class visibility="public" isSpecification="false" namespace="Logical_View" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="uvtV1cci93Dtv" comment="    Esta clase corresponde a la del Jugador que participa en el juego. Realiza las &#xa;    interacciones dadas por el usuario y depende totalmente de el. Van a haber entre 2 &#xa;    a 4 jugadores por juego.&#xa;" name="Jugador">
       <UML:Classifier.feature>
        <UML:Attribute visibility="public" isSpecification="false" xmi.id="uoMSioFFM2XJt" type="u8ncWzU6uaHhv" comment=":param x: coordenada en X donde se posicionara el jugador&#xa;:type x: int&#xa;:param y: coordenada en Y donde se posicionara el jugador&#xa;:type y: int&#xa;:param a: medida del ancho del jugador&#xa;:type a: int&#xa;:param l: medida de la altura del jugador&#xa;:type l: int&#xa;:param mX: es que tanto tiene que moverse en X este jugador en especifico, para&#xa;estar en una posicion despecifica en la casilla. Por ejemplo para quedar en una &#xa;esquina de abajo, o la de arriba...&#xa;:type mX: int&#xa;:param mY: es que tanto tiene que moverse en Y este jugador en especifico, para&#xa;estar en una posicion despecifica en la casilla. Por ejemplo para quedar en una &#xa;esquina de abajo, o la de arriba...&#xa;:type mY: int&#xa;" name="x"/>
