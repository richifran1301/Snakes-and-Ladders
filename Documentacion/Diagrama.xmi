        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" ownerScope="classifier" isRoot="false" xmi.id="u0fj43KYETpEu" comment="    Este metodo se utiliza para decidir el orden de los turnos de los jugadores, cada uno lanza dados y el mas alto, va de primero y asi sucesivamente&#xa;    @param cantidad_jugadores: recibe la cantidad de jugadores que estan en la partida&#xa;    @type cantidad_jugadores: numero entero&#xa;    @param boton_dados: recibe una instancia de un boton de dados del cual se sacara la informacion de los dados&#xa;    @type boton_dados: instancia de la clase button&#xa;    @param dado: el dado que se lanzara para sacar un numero al azar&#xa;    @type dado: una instancia de dado&#xa;" isOverride="false" name="reporte_jugadores" isInline="false" isVirtual="false">
         <UML:BehavioralFeature.parameter>
          <UML:Parameter kind="return" xmi.id="uJtwhSs4A8DjB" type="ubpT3V8kZN49o"/>
          <UML:Parameter visibility="private" isSpecification="false" xmi.id="umUZnCmfTYMhv" type="ubpT3V8kZN49o" value="" name="cls"/>
