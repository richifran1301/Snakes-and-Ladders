        <UML:Operation visibility="public" isSpecification="false" isQuery="false" isAbstract="false" isLeaf="false" isRoot="false" xmi.id="ukvp8jwkJKgUa" comment="        Esta funciÃ³n devuelve la tupla de casillas correspondiente a una tupla de Ã­ndices inicio y fin.&#xa;        :param indice: El Ã­ndice de la casilla en la lista general de casillas.&#xa;        :type indice: int&#xa;        :param posiciones: Lista de tuplas con las posiciones inicial y final de cada serpiente o escalera.&#xa;        :type posiciones: list&#xa;        :returns:  tuple -- Devuelve la tupla de dos casillas, la de inicio en pos 0 y la de fin en pos 1.&#xa; obtenga la tupla de posiciones donde estÃ¡ ese Ã­ndice obtenga la versiÃ³n de esa tupla con objetos Casilla" isOverride="false" name="getPar" isInline="false" isVirtual="false">
